# Windows-native build for the mingw-w64 from Chocolatey (choco install mingw).
#
#   mingw32-make -f Makefile.win             -> mrecord.exe
#   mingw32-make -f Makefile.win test        -> host-side unit tests
#   mingw32-make -f Makefile.win dist        -> dist\mrecord-<version>-win64.zip
#   mingw32-make -f Makefile.win clean
#
# Needs only gcc, windres and mingw32-make from that package; no sh, rm, touch
# or python. The version is read from the VERSION line of the main Makefile
# (which tools/bump.py and CI keep up to date), so there is one place to bump.

# Always run recipes through cmd, even when Git's sh.exe is on PATH.
SHELL := cmd.exe

WINDRES ?= windres

# make predefines CC as cc; Chocolatey's mingw ships gcc.exe.
ifeq ($(origin CC),default)
CC := gcc
endif

VERSION := $(lastword $(shell findstr /B /C:"VERSION  =" Makefile))
ifeq ($(VERSION),)
VERSION := 0.0.0
endif

VER_MAJOR := $(word 1,$(subst ., ,$(VERSION)))
VER_MINOR := $(word 2,$(subst ., ,$(VERSION)))
VER_PATCH := $(word 3,$(subst ., ,$(VERSION)))

# \" survives cmd and gcc's command-line parsing; '"..."' does not.
CFLAGS   = -O2 -s -flto -mwindows \
           -DUNICODE -D_UNICODE \
           -DMRECORD_VERSION=\"$(VERSION)\" \
           -Wall -Wextra -Wno-unused-parameter \
           $(CFLAGS_EXTRA)

CFLAGS_EXTRA ?=

RCFLAGS  = -DVER_MAJOR=$(VER_MAJOR) \
           -DVER_MINOR=$(VER_MINOR) \
           -DVER_PATCH=$(VER_PATCH)

LDLIBS   = -luser32 -lgdi32 -lshell32 -lole32 -luuid -ldwmapi -lwinmm \
           -ld3d11 -ldxgi -lmfplat -lmfreadwrite -lmfuuid

SRC_DIR  = src

PURE_SRCS = $(SRC_DIR)/args.c    \
            $(SRC_DIR)/geom.c    \
            $(SRC_DIR)/naming.c  \
            $(SRC_DIR)/pacing.c  \
            $(SRC_DIR)/convert.c

WIN_SRCS  = $(SRC_DIR)/main.c     \
            $(SRC_DIR)/console.c  \
            $(SRC_DIR)/control.c  \
            $(SRC_DIR)/monitors.c \
            $(SRC_DIR)/select.c   \
            $(SRC_DIR)/border.c   \
            $(SRC_DIR)/capture.c  \
            $(SRC_DIR)/cursor.c   \
            $(SRC_DIR)/encoder.c  \
            $(SRC_DIR)/audio.c    \
            $(SRC_DIR)/log.c

MRECORD_SRCS = $(PURE_SRCS) $(WIN_SRCS)
MRECORD_OBJS = $(MRECORD_SRCS:.c=.o)
RES_OBJ      = $(SRC_DIR)/mrecord.res.o

PURE_HDRS = $(SRC_DIR)/args.h $(SRC_DIR)/geom.h $(SRC_DIR)/naming.h \
            $(SRC_DIR)/pacing.h $(SRC_DIR)/convert.h

TARGET    = mrecord.exe

DISTNAME   = mrecord-$(VERSION)-win64
DIST_FILES = README.md,CHANGELOG.md,MANUAL-TESTS.md,LICENSE

TEST_DIR  = test
TEST_BINS = $(TEST_DIR)/test_args.exe    \
            $(TEST_DIR)/test_geom.exe    \
            $(TEST_DIR)/test_naming.exe  \
            $(TEST_DIR)/test_pacing.exe  \
            $(TEST_DIR)/test_convert.exe

# cmd wants backslashes in paths it is given directly.
winpath = $(subst /,\,$(1))

.PHONY: all clean dist test print-version

all: $(TARGET)

print-version:
	@echo $(VERSION)

# Objects depend on this file so a version change rebuilds everything.
$(MRECORD_OBJS) $(RES_OBJ): Makefile.win Makefile

$(TARGET): $(MRECORD_OBJS) $(RES_OBJ)
	@echo   LINK  $@
	$(CC) $(CFLAGS) -o $@ $^ $(LDLIBS)

$(SRC_DIR)/log.o: $(SRC_DIR)/log.c $(SRC_DIR)/log.h
	@echo   CC    $<
	$(CC) $(CFLAGS) -c -o $@ $<

$(SRC_DIR)/%.o: $(SRC_DIR)/%.c $(SRC_DIR)/mrecord.h $(PURE_HDRS)
	@echo   CC    $<
	$(CC) $(CFLAGS) -c -o $@ $<

$(RES_OBJ): $(SRC_DIR)/mrecord.rc $(SRC_DIR)/mrecord.exe.manifest
	@echo   RC    $<
	$(WINDRES) $(RCFLAGS) -I$(SRC_DIR) -O coff -i $< -o $@

$(TEST_DIR)/test_%.exe: $(TEST_DIR)/test_%.c $(SRC_DIR)/%.c $(SRC_DIR)/%.h $(TEST_DIR)/tests.h
	@echo   HOSTCC $@
	$(CC) -O1 -Wall -Wextra -o $@ $(TEST_DIR)/test_$*.c $(SRC_DIR)/$*.c -lm

# Stops at the first failing test; make then reports the error.
test: $(TEST_BINS)
	@echo   TEST
	@$(foreach t,$(TEST_BINS),$(call winpath,$(t)) &&) echo   all tests passed

dist: $(TARGET)
	@echo   DIST  $(DISTNAME)
	powershell -NoProfile -Command "New-Item -ItemType Directory -Force dist/$(DISTNAME) | Out-Null; Copy-Item $(TARGET),$(DIST_FILES) dist/$(DISTNAME); Compress-Archive -Force dist/$(DISTNAME) dist/$(DISTNAME).zip"
	@echo   -^>    dist\$(DISTNAME).zip

clean:
	-del /Q /F $(call winpath,$(TARGET) $(MRECORD_OBJS) $(RES_OBJ) $(TEST_BINS)) 2>nul
